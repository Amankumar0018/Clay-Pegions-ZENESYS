# NEXUS AI Environment Configuration
DATABASE_URL=sqlite:///./nexus_ai.db
LLM_API_KEY=your_gemini_api_key_here
PORT=8000
FRONTEND_URL=http://localhost:3000

# NetSuite Integration (SuiteTalk REST API / OAuth 2.0)
NETSUITE_ACCOUNT_ID=your_netsuite_account_id
NETSUITE_CLIENT_ID=your_netsuite_client_id
NETSUITE_CLIENT_SECRET=your_netsuite_client_secret
NETSUITE_TOKEN_ID=your_token_id
NETSUITE_TOKEN_SECRET=your_token_secret
NETSUITE_MODE=demo # Options: 'demo' or 'live'
